PORT=3000

# Comma-separated origins allowed to call the API and the hub.
# Leave unset locally (any origin is allowed). In production set it to your site, e.g.
# CORS_ORIGIN=https://your-name.github.io
CORS_ORIGIN=

# pollinations (no key) | groq | openrouter | gemini | xai | openai | anthropic | mock
AI_PROVIDER=pollinations
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=60000
# AI_PERSONA=You are the answerer in a support conversation: helpful, direct, and warm without being chatty.
# AI_MODEL=
# AI_BASE_URL=

# Free tier, faster and smarter than the keyless default — https://console.groq.com/keys
# GROQ_API_KEY=

# Free tier — https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Free tier — https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Paid, xAI Grok — https://console.x.ai
# XAI_API_KEY=

# Paid — https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Paid
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low
